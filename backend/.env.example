PROJECT_NAME="NeuroFusion AI"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URLs (MySQL with user root)
DATABASE_URL="mysql+aiomysql://root:password@localhost:3306/neurofusion"
SYNC_DATABASE_URL="mysql+pymysql://root:password@localhost:3306/neurofusion"

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL_WHITELIST=["admin@neurofusion.health"]
